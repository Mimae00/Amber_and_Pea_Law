# AI service configuration. Copy to ai-service/.env for local runs.
# In containers, set these as real environment variables instead.

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Comma-separated, no wildcards
CORS_ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_TRUST_FORWARDED=false

# --- LLM that writes the answer ---
# ollama  : local Ollama (default, nothing leaves your machine)
# openai  : any OpenAI-compatible API (OpenAI, Azure OpenAI, Groq, vLLM, LM Studio...)
# none    : no LLM; replies with the best-matching knowledge base passages and citations
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
# Only for LLM_PROVIDER=openai, e.g. LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=350
LLM_TIMEOUT_SECONDS=60

# --- Embeddings used for vector search ---
# ollama  : local Ollama model (run: ollama pull nomic-embed-text)
# openai  : OpenAI-compatible /embeddings endpoint
# default : Chroma's built-in local ONNX model (all-MiniLM-L6-v2, downloaded once)
# Re-run the ingest script after changing the embedding provider or model.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
# nomic-embed-text expects task prefixes; leave empty for other models
EMBEDDING_QUERY_PREFIX="search_query:"
EMBEDDING_DOCUMENT_PREFIX="search_document:"
EMBEDDING_TIMEOUT_SECONDS=30

# --- Vector store ---
# persistent : embedded ChromaDB in CHROMA_PATH (local dev)
# http       : remote Chroma server at CHROMA_HOST:CHROMA_PORT (for containers later)
CHROMA_MODE=persistent
CHROMA_PATH=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_COLLECTION=amber_pea_kb

# --- Retrieval ---
KNOWLEDGE_BASE_DIR=../knowledge-base
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATES=10
RRF_K=60
# Relevance gate: answer only if the best vector hit is within this cosine distance
# or the best BM25 score reaches MIN_BM25_SCORE
MAX_VECTOR_DISTANCE=0.42
MIN_BM25_SCORE=1.5
CHUNK_MAX_CHARS=900

# --- Firm details used in fixed replies (sample content) ---
FIRM_NAME=Amber & Pea Law
FIRM_PHONE=(555) 010-0142
BOOKING_PATH=/book
