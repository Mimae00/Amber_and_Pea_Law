# API configuration. Copy to api/.env for local runs (imported by application.yml).
# In containers, set these as real environment variables instead.

SERVER_PORT=8080
LOG_LEVEL=INFO

# Must match the root .env used by docker-compose.dev.yml
DB_URL=jdbc:postgresql://localhost:5432/amberpea
DB_USERNAME=amberpea
DB_PASSWORD=change-me-local-dev-password
DB_POOL_SIZE=10

# Comma-separated, no wildcards
CORS_ALLOWED_ORIGINS=http://localhost:5173

# At least 32 bytes. Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=amber-pea-law-api
JWT_TTL_MINUTES=120

# First admin, created at startup only if no admin exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_DISPLAY_NAME=Site Admin

# Rate limiting (per client IP, per minute)
RATE_LIMIT_TRUST_FORWARDED=false
RATE_LIMIT_FORMS_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=10

# Booking rules
BOOKING_TIMEZONE=America/Chicago
BOOKING_BUSINESS_DAYS=MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY
BOOKING_OPEN=09:00
BOOKING_CLOSE=17:00
BOOKING_SLOT_MINUTES=30
BOOKING_MIN_NOTICE_HOURS=2
BOOKING_MAX_DAYS_AHEAD=30
