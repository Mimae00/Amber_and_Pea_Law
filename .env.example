# Root .env used by docker-compose.dev.yml (local PostgreSQL only).
# Copy to .env and change the password. Never commit .env.
POSTGRES_DB=amberpea
POSTGRES_USER=amberpea
POSTGRES_PASSWORD=change-me-local-dev-password
POSTGRES_PORT=5432

# Optional host ports for the full stack in docker-compose.yml (defaults shown).
# The frontend is rebuilt with these URLs, so change them before `docker compose up --build`.
# FRONTEND_PORT=3000
# API_PORT=8080
# AI_PORT=8000
