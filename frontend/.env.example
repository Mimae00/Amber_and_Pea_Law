# Frontend configuration. Copy to frontend/.env.local for local runs.
# VITE_* values are baked in at build time.

# Base URL of the Spring Boot API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080
# Base URL of the FastAPI AI service (Phase 3)
VITE_AI_BASE_URL=http://localhost:8000
# Public URL of the site, used for canonical links, sitemap.xml and JSON-LD
VITE_SITE_URL=http://localhost:5173

# Dev server port (used by vite.config.ts, not exposed to the browser)
PORT=5173
